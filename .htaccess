RewriteEngine On

RewriteCond %{HTTP_HOST} ^lxue\.xin$ [NC]
RewriteRule ^(.*)$ https://www.lxue.xin/$1 [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 旧公开地址统一到无 .html 的规范 URL；THE_REQUEST 防止内部重写形成循环。
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [L,R=301,NE]

RewriteCond %{THE_REQUEST} \s/+blog\.html(?:[?\s]) [NC]
RewriteRule ^blog\.html$ /blog/ [L,R=301,NC,NE]

RewriteCond %{THE_REQUEST} \s/+articles/weijia-daodao-prime-sgfe\.html(?:[?\s]) [NC]
RewriteRule ^articles/weijia-daodao-prime-sgfe\.html$ /articles/lingxue-ai-prime-sgfe [L,R=301,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [L,R=301,NE]

# 无后缀公开 URL 仍由现有静态 HTML 文件提供。
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.html [NC,L]

<IfModule mod_headers.c>
    <FilesMatch "\.txt$">
        Header set Content-Type "text/plain; charset=UTF-8"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    <FilesMatch "\.xml$">
        Header set Content-Type "application/xml; charset=UTF-8"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    <FilesMatch "\.html$">
        Header set Content-Type "text/html; charset=UTF-8"
    </FilesMatch>

    <FilesMatch "\.css$">
        Header set Content-Type "text/css; charset=UTF-8"
    </FilesMatch>

    <FilesMatch "\.js$">
        Header set Content-Type "application/javascript; charset=UTF-8"
    </FilesMatch>

    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    <FilesMatch "\.(html|txt|xml)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType text/plain .txt
    AddType application/xml .xml
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
</IfModule>
